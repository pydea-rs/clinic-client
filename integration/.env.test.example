# Required — must point to a real PostgreSQL test database
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/ai_clinic_test

# Session
SESSION_SECRET=test-session-secret-for-integration-tests
SESSION_COOKIE_NAME=test-sid

# CORS (test server uses random port, this is just for the config validation)
CORS_ORIGIN=http://localhost:0

# Storage — local uploads in temp dir
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./.tmp-uploads

# AI keys — dummy values (services are mocked)
OPENAI_API_KEY=sk-test-dummy-key-not-real
OPENAI_MODEL=gpt-3.5-turbo
BOTAGENT_KEY=test-botpress-webhook-id

# Superadmin seed credentials
SUPERUSER_EMAIL=admin@ai-clinic.com
SUPERUSER_PASSWORD=SuperAdmin123!
